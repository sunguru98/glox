// Function declarations
fun sayHi(first, last) {
  print "Hi, " + first + " " + last + "!";
}

fun add(a, b, c) {
  print a + b + c;
}

fun fib(n) {
  if (n <= 1) return n;
  return fib(n - 2) + fib(n - 1);
}

// Function calls
add(1, 2, 3);

sayHi("Dear", "Reader");

for (var i = 0; i < 20; i = i + 1) {
  print fib(i);
}